# Copy to runner/.env — never commit this file.
# The token is issued once by the dashboard: Runners tab -> Create runner.
CLIPPER_RUNNER_TOKEN=clpr_paste_your_token_here

# Optional overrides (runner.json is the primary config).
# CLIPPER_DASHBOARD_URL=http://localhost:5173

# Twitch dev app: https://dev.twitch.tv/console/apps (2FA required).
# Without these the runner cannot read live status or chat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick app: account settings -> Developer (2FA required).
# Used only for stream status in phase A; Kick chat needs the webhook receiver.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
